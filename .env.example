# ORION Application Configuration
ORION_APP_NAME="ORION"
ORION_ENV="development"
ORION_HOST="127.0.0.1"
ORION_PORT=8000
ORION_DEBUG=false

# Telegram Bot Configuration
# Token obtained from @BotFather
ORION_TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Your numeric Telegram user ID (obtainable safely via @userinfobot)
ORION_TELEGRAM_OWNER_ID=123456789

# Local Ollama Configuration
ORION_OLLAMA_MODEL="qwen3.5:4b"
ORION_OLLAMA_BASE_URL="http://127.0.0.1:11434"
ORION_OLLAMA_TIMEOUT=25.0
ORION_OLLAMA_PLAN_NUM_PREDICT=1024

# Memory & Storage Configuration
ORION_DATABASE_PATH="data/orion.db"
ORION_MAX_HISTORY_MESSAGES=10
ORION_MAX_GOAL_LENGTH=500

# Windows Tools Configuration
# Comma-separated list of absolute folder paths ORION is permitted to list/search.
# Defaults to empty (no filesystem access).
ORION_ALLOWED_DIRECTORIES=""

# Voice Notes & Speech-to-Text Configuration (Step 12)
ORION_VOICE_ENABLED=true
ORION_WHISPER_MODEL="base"
ORION_WHISPER_DEVICE="cpu"
ORION_WHISPER_COMPUTE_TYPE="int8"
ORION_WHISPER_DOWNLOAD_ROOT=""
ORION_MAX_VOICE_DURATION_SECONDS=60
ORION_MAX_VOICE_FILE_SIZE_BYTES=5242880

# Reminders & Timezone Configuration (Step 17)
ORION_TIMEZONE="Asia/Kolkata"
ORION_REMINDER_CHECK_INTERVAL_SECONDS=10.0
